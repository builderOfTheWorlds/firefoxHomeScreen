{
  "manifest_version": 2,
  "name": "GitTabSync",
  "version": "1.0.7",
  "description": "A customizable homescreen with bookmarks organized by folders, synced via GitHub",
  "browser_specific_settings": {
    "gecko": {
      "id": "github-bookmark-homescreen@builderOfTheWorlds",
      "data_collection_permissions": {
        "required": [
          "none"
        ],
        "optional": []
      }
    }
  },
  "permissions": [
    "storage",
    "tabs",
    "<all_urls>",
    "https://api.github.com/*",
    "https://raw.githubusercontent.com/*"
  ],
  "browser_action": {
    "default_icon": {
      "48": "icons/icon-48.png"
    },
    "default_title": "GitTabSync",
    "default_popup": "popup.html"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  },
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "background": {
    "scripts": [
      "screenshot-db.js",
      "background.js"
    ]
  }
}
